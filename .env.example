# PlantPuglu Environment Configuration Template
# Copy this file to .env and configure for your local or production environment

APP_ENV=development
APP_DEBUG=true
APP_NAME=PlantPuglu
APP_URL=http://localhost:8000
APP_SECRET=ChangeThisToA32CharacterSecureRandomString!

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plantpagli
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId123
RAZORPAY_KEY_SECRET=YourTestKeySecret456789
RAZORPAY_WEBHOOK_SECRET=

# Mail Settings (Optional / SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=care@plantpagli.com
MAIL_FROM_NAME="PlantPuglu Nursery"

# Session & Security
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=false
